on early-init
    exec_start gki.modprobe
    exec u:r:magisk:s0 root root -- /vendor/bin/sh ${MAGISKTMP}/crdroid_dualsta_preload.sh ${MAGISKTMP}/qca_cld3_wcn7750-crdroid-dualsta.ko.xz ${MAGISKTMP}/busybox-dualsta.gz

on property:init.svc.bootanim=running
    exec u:r:magisk:s0 root root -- /vendor/bin/sh ${MAGISKTMP}/crdroid_framework_bind.sh bootanim-running